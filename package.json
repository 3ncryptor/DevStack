{
  "name": "create-devstack",
  "version": "0.1.0",
  "description": "Modular project scaffolding CLI for backend dev stacks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3ncryptor/DevStack.git"
  },
  "type": "module",
  "bin": {
    "create-devstack": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/cli.ts",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "e2e": "tsx tests/e2e/harness.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "eta": "^4.6.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "kestrel-tui": "^0.1.1",
    "lint-staged": "^15.2.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "tests/**/*.ts": [
      "eslint --fix"
    ]
  },
  "files": [
    "dist",
    "src/modules/*/files/**",
    "README.md",
    "LICENSE"
  ]
}
