{
  "name": "create-devstack-app",
  "version": "1.0.0",
  "description": "Scaffold a running, wired TypeScript project from the stack you choose",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3ncryptor/DevStack.git"
  },
  "type": "module",
  "bin": {
    "create-devstack-app": "dist/cli.js",
    "devstack": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/cli.ts",
    "lint": "eslint .",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "e2e": "tsx tests/e2e/harness.ts --tier smoke",
    "e2e:full": "tsx tests/e2e/harness.ts --tier full",
    "e2e:sample": "tsx tests/e2e/harness.ts --tier full --pm pnpm --sample 5",
    "prepack": "npm run build",
    "test:coverage": "vitest run --coverage",
    "graph": "bash scripts/graphify.sh",
    "release:smoke": "tsx tests/e2e/release-smoke.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "eta": "^4.6.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.9.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "kestrel-tui": "^0.1.1",
    "lint-staged": "^15.2.10",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src/**/*.ts": [
      "eslint --fix"
    ],
    "tests/**/*.ts": [
      "eslint --fix"
    ]
  },
  "files": [
    "dist",
    "src/modules/**/files/**",
    "src/licenses",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://devstack-app-delta.vercel.app",
  "bugs": {
    "url": "https://github.com/3ncryptor/DevStack/issues"
  },
  "keywords": [
    "create",
    "scaffold",
    "cli",
    "typescript",
    "express",
    "nestjs",
    "prisma"
  ]
}
