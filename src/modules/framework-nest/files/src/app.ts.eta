import { NestFactory, Reflector } from '@nestjs/core'
import type { NestExpressApplication } from '@nestjs/platform-express'

<%~ it.slots['app.imports'] %>

import { AppModule } from './app.module.js'
import { ErrorFilter } from './filters/error.filter.js'
import { EnvelopeInterceptor } from './interceptors/envelope.interceptor.js'
import type { Logger } from './lib/logger.js'
import { NestLogger } from './lib/nest-logger.js'
import type { ReadinessCheck } from './lib/readiness.js'
import { requestId } from './middlewares/request-id.js'

export interface AppDeps {
  logger: Logger
  readinessChecks: readonly ReadinessCheck[]
}

/** Builds the app without listening, so tests use it directly (B17.2). */
export async function createApp(deps: AppDeps): Promise<NestExpressApplication> {
  const app = await NestFactory.create<NestExpressApplication>(AppModule.register(deps), {
    logger: new NestLogger(deps.logger)
  })

  // Do not advertise the framework, even when no security middleware is selected.
  app.disable('x-powered-by')

  // Order (B17.2): request id, logging, security; Nest parses bodies and routes after these.
  app.use(requestId(deps.logger))
  <%~ it.slots['app.middleware'] %>

  app.useGlobalFilters(new ErrorFilter(deps.logger))
  app.useGlobalInterceptors(new EnvelopeInterceptor(app.get(Reflector)))
  return app
}
