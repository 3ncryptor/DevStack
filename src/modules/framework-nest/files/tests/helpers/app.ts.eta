import type { NestExpressApplication } from '@nestjs/platform-express'

import { createApp, type AppDeps } from '../../src/app.js'
import { createLogger } from '../../src/lib/logger.js'
<%~ it.slots['test.imports'] %>

/** The app with test doubles for every dependency (slot `test.deps`), initialised, not listening. */
export async function testApp(overrides: Partial<AppDeps> = {}): Promise<NestExpressApplication> {
  const app = await createApp({
    logger: createLogger('silent'),
    readinessChecks: [],
    <%~ it.slots['test.deps'] %>
    ...overrides
  })
  await app.init()
  return app
}
