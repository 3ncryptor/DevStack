# Local development stack. The database credentials below are for local use only.
# Host ports are configurable when 3000 or 5432 are taken: PORT=4000 POSTGRES_PORT=5433 docker compose up
<% const hasDatabase = it.modules.includes('orm-prisma') %>
services:
  app:
    build: .
    ports:
      - '${PORT:-3000}:3000'
    env_file:
      - path: .env
        required: false
    environment:
      # the container always listens on 3000 (EXPOSE, healthcheck); PORT only picks the host port
      PORT: 3000
<% if (hasDatabase) { %>      DATABASE_URL: postgresql://postgres:postgres@db:5432/devstack
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: devstack
    ports:
      - '${POSTGRES_PORT:-5432}:5432'
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U postgres -d devstack']
      interval: 5s
      timeout: 3s
      retries: 10
    volumes:
      - postgres_data:/var/lib/postgresql

volumes:
  postgres_data:
<% } %>