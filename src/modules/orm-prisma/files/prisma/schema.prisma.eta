generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.mjs (Prisma 7).
datasource db {
  provider = "<%= it.modules.includes('database-mysql') ? 'mysql' : it.modules.includes('database-sqlite') ? 'sqlite' : 'postgresql' %>"
}

// Add your models here, then run the db:migrate script.
<%~ it.slots['prisma.models'] ? `\n${it.slots['prisma.models']}\n` : '' %>