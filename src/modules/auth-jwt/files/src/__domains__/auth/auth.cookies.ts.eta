<% if (it.modules.includes('framework-fastify')) { %>
import type { CookieSerializeOptions } from '@fastify/cookie'
import type { FastifyReply, FastifyRequest } from 'fastify'

import type { AuthConfig } from './auth.config.js'
import type { Session } from './auth.service.js'

export const ACCESS_COOKIE = 'access_token'
export const REFRESH_COOKIE = 'refresh_token'

/**
 * httpOnly, so page scripts never see a token. Development: `SameSite=Lax` over http through the
 * web app's proxy. Production: `Secure; SameSite=None` for a split-origin web app (D-29); writes
 * are then guarded by the origin check (see require-auth.ts). Path `/` because the browser sees
 * the API under the proxy's prefix in development.
 */
function cookieOptions(config: AuthConfig): CookieSerializeOptions {
  return {
    httpOnly: true,
    secure: config.production,
    sameSite: config.production ? 'none' : 'lax',
    path: '/'
  }
}

export function setSessionCookies(reply: FastifyReply, config: AuthConfig, session: Session): void {
  void reply.setCookie(ACCESS_COOKIE, session.accessToken.token, {
    ...cookieOptions(config),
    expires: session.accessToken.expiresAt
  })
  void reply.setCookie(REFRESH_COOKIE, session.refreshToken.token, {
    ...cookieOptions(config),
    expires: session.refreshToken.expiresAt
  })
}

export function clearSessionCookies(reply: FastifyReply, config: AuthConfig): void {
  void reply.clearCookie(ACCESS_COOKIE, cookieOptions(config))
  void reply.clearCookie(REFRESH_COOKIE, cookieOptions(config))
}

export function readCookie(request: FastifyRequest, name: string): string | undefined {
  const value = request.cookies[name]
  return typeof value === 'string' && value.length > 0 ? value : undefined
}
<% } else { %>
import type { CookieOptions, Request, Response } from 'express'

import type { AuthConfig } from './auth.config.js'
import type { Session } from './auth.service.js'

export const ACCESS_COOKIE = 'access_token'
export const REFRESH_COOKIE = 'refresh_token'

/**
 * httpOnly, so page scripts never see a token. Development: `SameSite=Lax` over http through the
 * web app's proxy. Production: `Secure; SameSite=None` for a split-origin web app (D-29); writes
 * are then guarded by the origin check (see require-auth.ts). Path `/` because the browser sees
 * the API under the proxy's prefix in development.
 */
function cookieOptions(config: AuthConfig): CookieOptions {
  return {
    httpOnly: true,
    secure: config.production,
    sameSite: config.production ? 'none' : 'lax',
    path: '/'
  }
}

export function setSessionCookies(response: Response, config: AuthConfig, session: Session): void {
  response.cookie(ACCESS_COOKIE, session.accessToken.token, {
    ...cookieOptions(config),
    expires: session.accessToken.expiresAt
  })
  response.cookie(REFRESH_COOKIE, session.refreshToken.token, {
    ...cookieOptions(config),
    expires: session.refreshToken.expiresAt
  })
}

export function clearSessionCookies(response: Response, config: AuthConfig): void {
  response.clearCookie(ACCESS_COOKIE, cookieOptions(config))
  response.clearCookie(REFRESH_COOKIE, cookieOptions(config))
}

export function readCookie(request: Request, name: string): string | undefined {
  const cookies = request.cookies as Record<string, unknown> | undefined
  const value = cookies?.[name]
  return typeof value === 'string' && value.length > 0 ? value : undefined
}
<% } %>
