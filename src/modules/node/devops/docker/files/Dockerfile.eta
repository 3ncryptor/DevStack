# syntax=docker/dockerfile:1
# Multi-stage build: build tools and dev dependencies never reach the runtime image.

FROM <%= it.language.dockerBaseImage %> AS base
WORKDIR /app
<% if (it.pm.setup !== '') { %><%= it.pm.setup %>
<% } %>
FROM base AS build
# git hooks are not needed inside the image
ENV HUSKY=0
COPY <%= it.pm.manifests %> ./
RUN <%= it.pm.installFrozen %>
COPY . .
<% for (const step of it.postInstall) { %>RUN <%= it.pm.exec %> <%= step %>
<% } %>RUN <%= it.pm.run %> build

FROM base AS prod-deps
COPY <%= it.pm.manifests %> ./
RUN <%= it.pm.installProd %>
<% if (it.productionBuilds.length > 0) { %>RUN <%= it.pm.rebuild %> <%= it.productionBuilds.join(' ') %>
<% } %>
FROM <%= it.language.dockerBaseImage %> AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node package.json ./
<% if (it.database?.compose.kind === 'file') { %># the database file lives on a volume mounted here (docker-compose.yml)
RUN mkdir -p <%= it.database.compose.dataDir %> && chown node:node <%= it.database.compose.dataDir %>
<% } %># never run as root
USER node
EXPOSE <%= it.apps.backend.port %>
HEALTHCHECK --interval=10s --timeout=3s --start-period=30s --retries=5 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:<%= it.apps.backend.port %>/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
# node directly (not npm start) so SIGTERM reaches the app and it shuts down gracefully
CMD ["node", "<%= it.entry %>"]
