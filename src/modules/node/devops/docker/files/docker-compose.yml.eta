<% const database = it.database?.compose -%>
<% const redis = it.modules.includes('cache-redis') -%>
<% const dependsOn = [...(database?.kind === 'service' ? ['db'] : []), ...(redis ? ['redis'] : [])] -%>
<% const connections = () => [
  ...(database ? [`      DATABASE_URL: ${database.url}`] : []),
  ...(redis ? ['      REDIS_URL: redis://redis:6379'] : []),
  ...(dependsOn.length > 0 ? ['    depends_on:'] : []),
  ...dependsOn.flatMap((service) => [`      ${service}:`, '        condition: service_healthy']),
  // a file database outlives the container
  ...(database?.kind === 'file' ? ['    volumes:', `      - ${database.volume}:${database.dataDir}`] : [])
].map((line) => `${line}\n`).join('') -%>
<% const volumes = [...(database ? [database.volume] : []), ...(redis ? ['redis_data'] : [])] -%>
<% const monorepo = it.modules.includes('layout-monorepo') -%>
<% const api = it.apps.backend -%>
<% const webApps = monorepo && it.modules.includes('devops-docker-web') ? [['frontend', 'WEB'], ...(it.modules.includes('app-admin') ? [['admin', 'ADMIN']] : [])].map(([role, hostVar]) => ({ ...it.apps[role], hostVar })) : [] -%>
# Local stack (D-41): docker compose up runs everything, each service starting once the one it
# needs is healthy. The database credentials below are for local use only.
# Host ports are configurable when taken, e.g. PORT=4000 POSTGRES_PORT=5433 docker compose up
services:
<% if (monorepo) { %>
  <%= api.name %>:
    build:
      context: .
      dockerfile: <%= api.dir %>/Dockerfile
    ports:
      - '${API_PORT:-<%= api.port %>}:<%= api.port %>'
    # secrets such as JWT_SECRET come from the API's local .env; compose overrides the rest
    env_file:
      - path: <%= api.dir %>/.env
        required: false
    environment:
      PORT: <%= api.port %>
<% if (webApps.length > 0) { %>      ALLOWED_ORIGINS: <%= webApps.map((web) => `http://localhost:${web.port}`).join(',') %>
<% } %><%~ connections() -%>
<% for (const web of webApps) { %>
  <%= web.name %>:
    build:
      context: .
      dockerfile: <%= web.dir %>/Dockerfile
    ports:
      - '${<%= web.hostVar %>_PORT:-<%= web.port %>}:<%= web.port %>'
    environment:
      # the server-rendered status page calls the API inside the compose network
      API_URL: http://<%= api.name %>:<%= api.port %>
    depends_on:
      <%= api.name %>:
        condition: service_healthy
<% } -%>
<% } else { %>
  app:
    build: .
    ports:
      - '${PORT:-<%= api.port %>}:<%= api.port %>'
    env_file:
      - path: .env
        required: false
    environment:
      # the container always listens on <%= api.port %> (EXPOSE, healthcheck); PORT only picks the host port
      PORT: <%= api.port %>
<%~ connections() -%>
<% } -%>
<% if (database?.kind === 'service') { -%>

  db:
<% for (const line of database.definition) { -%>
    <%= line %>
<% } -%>
<% } -%>
<% if (redis) { -%>

  redis:
    image: redis:8-alpine
    ports:
      - '${REDIS_PORT:-6379}:6379'
    healthcheck:
      test: ['CMD', 'redis-cli', 'ping']
      interval: 5s
      start_period: 60s
      timeout: 3s
      retries: 10
    volumes:
      - redis_data:/data
<% } -%>
<% if (volumes.length > 0) { -%>

volumes:
<% for (const volume of volumes) { -%>
  <%= volume %>:
<% } -%>
<% } -%>
