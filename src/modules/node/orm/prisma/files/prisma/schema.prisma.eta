generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
<% if (it.settings.moduleSystem === 'cjs') { -%>
  // the project is CommonJS; the default ESM client uses import.meta
  moduleFormat = "cjs"
<% } -%>
}

// The connection URL lives in prisma.config.mjs (Prisma 7).
datasource db {
  provider = "<%= it.database.dialect %>"
}

// Add your models here, then run the db:migrate script.
<%~ it.slots['prisma.models'] ? `\n${it.slots['prisma.models']}\n` : '' %>