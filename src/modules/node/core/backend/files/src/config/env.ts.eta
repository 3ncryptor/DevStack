import { existsSync } from 'node:fs'

import { z } from 'zod'

// Loaded when this module is first imported, so other modules see .env values when they read
// process.env at import time. The entry point imports this file first. Production sets its
// environment itself and never reads .env; existing variables always win over the file.
if (process.env.NODE_ENV !== 'production' && existsSync('.env')) {
  try {
    process.loadEnvFile('.env')
  } catch (error: unknown) {
    console.error(`Could not read .env: ${error instanceof Error ? error.message : String(error)}`)
    process.exit(1)
  }
}

const envSchema = z.object({
<% for (const variable of it.env) { %>
  /** <%= variable.description %> */
  <%= variable.name %>: <%= variable.schema %>,
<% } %>
})

export type Env = z.infer<typeof envSchema>

/** Validates the environment once, at startup, reporting every problem together (B17.7). */
export function loadEnv(source: NodeJS.ProcessEnv = process.env): Env {
  const parsed = envSchema.safeParse(source)
  if (!parsed.success) {
    const problems = parsed.error.issues.map(
      (issue) => `  ${issue.path.join('.')}: ${issue.message}`
    )
    throw new Error(`Invalid environment:\n${problems.join('\n')}`)
  }
  return parsed.data
}

/** For the entry point: a readable message and exit code 1 instead of a stack trace. */
export function loadEnvOrExit(): Env {
  try {
    return loadEnv()
  } catch (error: unknown) {
    console.error(error instanceof Error ? error.message : error)
    process.exit(1)
  }
}
