<% const tailwind = it.modules.includes('ui-tailwind') %>
<% const cls = (value) => (tailwind ? ` className="${value}"` : '') %>
<% const next = it.capabilities.includes('web:next') %>
<% const cssModules = it.modules.includes('ui-css-modules') %>
<%~ next ? "'use client'\n\n" : '' %><%~ next ? "import { useRouter } from 'next/navigation'\n" : '' %>
import { auth } from '../../lib/auth'
import { RequireAuth, useSessionUser } from '../../lib/auth/require-auth'
<%~ next ? '' : "import { useRouter } from '../../lib/navigation'\n" %><%~ cssModules ? "import ui from '../ui.module.css'\n" : '' %>
function Account() {
  const user = useSessionUser()
  const router = useRouter()

  function logout() {
    const toLogin = () => {
      router.push('/login')
    }
    // even if the API cannot be reached, the browser session is over: show the login page
    auth.logout().then(toLogin, toLogin)
  }

  return (
    <main<%~ cssModules ? ' className={ui.page}' : cls('mx-auto grid min-h-screen max-w-sm content-center gap-4 p-6') %>>
      <h1<%~ cls('text-2xl font-semibold') %>>Your account</h1>
      <p data-testid="account-email">{user.email}</p>
      <button type="button" onClick={logout}<%~ cls('rounded border px-3 py-2') %>>
        Log out
      </button>
      <a href="/"<%~ cls('underline') %>>Status page</a>
    </main>
  )
}

/** An example protected page: wrap any page in <RequireAuth> the same way. */
export default function AccountPage() {
  return (
    <RequireAuth>
      <Account />
    </RequireAuth>
  )
}
