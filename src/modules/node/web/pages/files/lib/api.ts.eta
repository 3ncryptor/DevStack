<% const versioned = it.modules.includes('api-versioning') %>
<% const authed = it.modules.includes('auth-jwt') || it.modules.includes('auth-better-auth') %>
import { createApiClient } from '<%= it.packageNames.shared %>'

const API_BASE = <%= it.capabilities.includes('web:next') ? 'process.env.NEXT_PUBLIC_API_URL' : 'import.meta.env.VITE_API_URL' %> ?? '/api'
const API_VERSION = '<%= versioned ? '/v1' : '' %>'
<% if (authed) { %>
/** The API's root as the browser reaches it, e.g. for Better Auth's own routes. */
export const API_ROOT = `${API_BASE}${API_VERSION}`
<% } %>

/**
 * Typed calls to the API: `const { data } = await api.get<Todo[]>('/todos')`. In development the
 * browser goes through the /api proxy; in production set <%= it.capabilities.includes('web:next') ? 'NEXT_PUBLIC_API_URL' : 'VITE_API_URL' %> (split origin, D-29).<% if (authed) { %>
 * The session cookies go with every call (credentials), to the API's origin in production too.<% } %>
 */
export const api = createApiClient({ baseUrl: `${API_BASE}${API_VERSION}`<%~ authed ? ", credentials: 'include'" : '' %> })
