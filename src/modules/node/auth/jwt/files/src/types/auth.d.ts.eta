<% if (it.modules.includes('framework-fastify')) { %>
import type { AccessClaims } from '../<%= it.domainsDir %>/auth/tokens.js'

// Set by requireAuth (src/<%= it.domainsDir %>/auth/require-auth.ts) on every request it lets through.
declare module 'fastify' {
  interface FastifyRequest {
    user?: AccessClaims
  }
}

export {}
<% } else { %>
import type { AccessClaims } from '../<%= it.domainsDir %>/auth/tokens.js'

// Set by requireAuth (src/<%= it.domainsDir %>/auth/require-auth.ts) on every request it lets through.
declare global {
  namespace Express {
    interface Request {
      user?: AccessClaims
    }
  }
}

export {}
<% } %>
