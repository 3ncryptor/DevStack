<% const tailwind = it.modules.includes('ui-tailwind') %>
<% const authed = it.modules.includes('auth-jwt') || it.modules.includes('auth-better-auth') %>
<% const todos = it.modules.includes('template-todo') %>
<% const cssModules = it.modules.includes('ui-css-modules') %>
import { useEffect, useState } from 'react'

import { getStatus, type Status } from '../lib/status'
<%~ cssModules ? "import ui from './ui.module.css'\n" : '' %>
const mark = (ok: boolean): string => (ok ? '✓ connected' : '✗ unreachable')

function describe(status: Status | undefined): string {
  if (status === undefined) return 'Checking the API…'
  return [
    `API ${mark(status.api)}`,
    ...Object.entries(status.checks).map(([name, value]) => `${name.toUpperCase()} ${mark(value === 'ok')}`)
  ].join(' · ')
}

/** Status page (B17.1): is the API up, and is each of its dependencies ready. */
export default function Home() {
  const [status, setStatus] = useState<Status>()

  useEffect(() => {
    let active = true
    void getStatus().then((current) => {
      if (active) setStatus(current)
    })
    return () => {
      active = false
    }
  }, [])

  return (
<% if (tailwind) { %>
    <main className="grid min-h-screen place-content-center gap-2 text-center">
      <h1 className="text-2xl font-semibold"><%= it.projectName %></h1>
      <p data-testid="status" className="text-neutral-600">
        {describe(status)}
      </p>
<% if (todos) { %>
      <a href="/todos" className="underline">
        Todos
      </a>
<% } %>
<% if (authed) { %>
      <nav className="flex justify-center gap-4 underline">
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
        <a href="/account">Account</a>
      </nav>
<% } %>
    </main>
<% } else { %>
    <main<%~ cssModules ? ' className={ui.page}' : '' %>>
      <h1><%= it.projectName %></h1>
      <p data-testid="status">{describe(status)}</p>
<% if (todos) { %>
      <a href="/todos">Todos</a>
<% } %>
<% if (authed) { %>
      <nav>
        <a href="/login">Log in</a> · <a href="/register">Register</a> · <a href="/account">Account</a>
      </nav>
<% } %>
    </main>
<% } %>
  )
}
