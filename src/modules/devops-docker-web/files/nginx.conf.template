# Filled in by the nginx image at start (envsubst on ${API_URL} and ${PORT}).
server {
  listen ${PORT};
  root /usr/share/nginx/html;

  location = /health {
    default_type application/json;
    return 200 '{"status":"ok"}';
  }

  # same origin for the browser, as in development: no CORS
  location /api/ {
    proxy_pass ${API_URL}/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # client-side routes (/login, /todos) load the app
  location / {
    try_files $uri /index.html;
  }
}
