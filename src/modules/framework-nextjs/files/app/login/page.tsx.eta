<% const tailwind = it.modules.includes('ui-tailwind') %>
<% const cls = (value) => (tailwind ? ` className="${value}"` : '') %>
<% const admin = it.target === 'admin' %>
<% const providerOptions = it.moduleOptions['auth-better-auth'] ?? {} %>
<% const providers = admin ? [] : [['github', 'GitHub'], ['google', 'Google']].filter(([id]) => providerOptions[id] === true) %>
'use client'

import { useRouter } from 'next/navigation'
import { useState, type FormEvent } from 'react'

import { ApiClientError } from '<%= it.packageNames.shared %>'

import { auth } from '../../lib/auth'
<% if (providers.length > 0) { %>
import type { SocialProvider } from '../../lib/auth/session'
<% } %>
import { formText } from '../../lib/auth/form'

/**
 * Where to go after logging in: ?next= when it stays on this site. It is resolved the way the
 * browser would, so `/\evil.example` or `//evil.example` (another origin) fall back.
 */
function nextPath(): string {
  const fallback = '<%= admin ? '/' : '/account' %>'
  const next = new URLSearchParams(window.location.search).get('next')
  if (next === null) return fallback
  const target = new URL(next, window.location.origin)
  return target.origin === window.location.origin
    ? `${target.pathname}${target.search}${target.hash}`
    : fallback
}

export default function LoginPage() {
  const router = useRouter()
  const [error, setError] = useState<string>()
  const [pending, setPending] = useState(false)

  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    const form = new FormData(event.currentTarget)
    setPending(true)
    setError(undefined)
    auth
      .login({ email: formText(form, 'email'), password: formText(form, 'password') })
      .then(
        () => {
          router.push(nextPath())
        },
        (failure: unknown) => {
          setError(failure instanceof ApiClientError ? failure.message : 'Could not log in')
          setPending(false)
        }
      )
  }

<% if (providers.length > 0) { %>
  function socialSignIn(provider: SocialProvider) {
    setError(undefined)
    auth.socialSignIn(provider, nextPath()).catch((failure: unknown) => {
      setError(failure instanceof ApiClientError ? failure.message : 'Could not start the sign-in')
    })
  }

<% } %>
  return (
    <main<%~ cls('mx-auto grid min-h-screen max-w-sm content-center gap-4 p-6') %>>
      <h1<%~ cls('text-2xl font-semibold') %>>Log in<%= admin ? ' to the admin' : '' %></h1>
      <form onSubmit={submit}<%~ cls('grid gap-3') %>>
        <label<%~ cls('grid gap-1') %>>
          Email
          <input name="email" type="email" autoComplete="email" required<%~ cls('rounded border px-3 py-2') %> />
        </label>
        <label<%~ cls('grid gap-1') %>>
          Password
          <input
            name="password"
            type="password"
            autoComplete="current-password"
            required<%~ cls('rounded border px-3 py-2') %>
          />
        </label>
        {error === undefined ? null : (
          <p role="alert"<%~ cls('text-red-600') %>>
            {error}
          </p>
        )}
        <button type="submit" disabled={pending}<%~ cls('rounded bg-neutral-900 px-3 py-2 text-white disabled:opacity-50') %>>
          {pending ? 'Logging in…' : 'Log in'}
        </button>
      </form>
<% if (providers.length > 0) { %>
      <div<%~ cls('grid gap-2') %>>
<% for (const [id, label] of providers) { %>
        <button type="button" onClick={() => { socialSignIn('<%= id %>') }}<%~ cls('rounded border px-3 py-2') %>>
          Continue with <%= label %>
        </button>
<% } %>
      </div>
<% } %>
<% if (!admin) { %>
      <p>
        No account yet? <a href="/register"<%~ cls('underline') %>>Register</a>
      </p>
<% } else { %>
      <p<%~ cls('text-neutral-600') %>>Only admins can log in here.</p>
<% } %>
    </main>
  )
}
