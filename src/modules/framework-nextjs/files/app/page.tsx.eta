<% const tailwind = it.modules.includes('ui-tailwind') %>
<% const title = it.target === 'admin' ? `${it.projectName} admin` : it.projectName %>
<% const authed = it.modules.includes('auth-jwt') || it.modules.includes('auth-better-auth') %>
<% const guarded = authed && it.target === 'admin' %>
<% const todos = it.modules.includes('template-todo') && it.target !== 'admin' %>
<% if (guarded) { %>
import { RequireAuth } from '../lib/auth/require-auth'
<% } %>
import { getStatus } from '../lib/status'

// read the API on every request, never at build time
export const dynamic = 'force-dynamic'

const mark = (ok: boolean): string => (ok ? '✓ connected' : '✗ unreachable')

/** Status page (B17.1): is the API up, and is each of its dependencies ready. */
export default async function Home() {
  const status = await getStatus()
  const line = [
    `API ${mark(status.api)}`,
    ...Object.entries(status.checks).map(([name, value]) => `${name.toUpperCase()} ${mark(value === 'ok')}`)
  ].join(' · ')

  return (
<% if (guarded) { %>
    // the admin app is for admins only (D-67); the API checks the role on its own routes too
    <RequireAuth role="ADMIN">
<% } %>
<% if (tailwind) { %>
    <main className="grid min-h-screen place-content-center gap-2 text-center">
      <h1 className="text-2xl font-semibold"><%= title %></h1>
      <p data-testid="status" className="text-neutral-600">
        {line}
      </p>
<% if (todos) { %>
      <a href="/todos" className="underline">
        Todos
      </a>
<% } %>
<% if (authed && !guarded) { %>
      <nav className="flex justify-center gap-4 underline">
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
        <a href="/account">Account</a>
      </nav>
<% } %>
    </main>
<% } else { %>
    <main>
      <h1><%= title %></h1>
      <p data-testid="status">{line}</p>
<% if (todos) { %>
      <a href="/todos">Todos</a>
<% } %>
<% if (authed && !guarded) { %>
      <nav>
        <a href="/login">Log in</a> · <a href="/register">Register</a> · <a href="/account">Account</a>
      </nav>
<% } %>
    </main>
<% } %>
<% if (guarded) { %>
    </RequireAuth>
<% } %>
  )
}
