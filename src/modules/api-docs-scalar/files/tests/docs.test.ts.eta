<% const vitest = it.modules.includes('testing-vitest') %>
<%~ it.modules.includes('framework-nest') ? "import 'reflect-metadata'\n\n" : '' %><% const fastify = it.modules.includes('framework-fastify') %>
<% const nest = it.modules.includes('framework-nest') %>
import assert from 'node:assert/strict'
<% if (vitest) { %>import { test } from 'vitest'<% } else if (it.modules.includes('testing-jest')) { %>import { test } from '@jest/globals'<% } else { %>import { test } from 'node:test'<% } %>

import request from 'supertest'

import { testApp } from './helpers/app.js'

<% if (fastify) { %>
// Supertest drives Fastify through its HTTP server once the app is ready
<% } %>
const app = <%= fastify ? '(await testApp()).server' : nest ? '(await testApp()).getHttpServer()' : 'testApp()' %>

<%= vitest || it.modules.includes('testing-jest') ? '' : 'await ' %>test('GET /openapi.json serves the OpenAPI document', async () => {
  const response = await request(app).get('/openapi.json')

  assert.equal(response.status, 200)
  assert.equal((response.body as { openapi: string }).openapi, '3.1.0')
})

<%= vitest || it.modules.includes('testing-jest') ? '' : 'await ' %>test('GET /docs serves the API reference', async () => {
<%~ fastify ? "  // Fastify's Scalar plugin serves the reference at /docs/ and redirects /docs there\n" : '' %>  const response = await request(app).get('<%= fastify ? '/docs/' : '/docs' %>')

  assert.equal(response.status, 200)
  assert.match(response.text, /openapi\.json/)
})
