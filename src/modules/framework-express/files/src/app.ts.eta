<% const versioned = it.modules.includes('api-versioning') %>
import express, { type Express } from 'express'

<%~ it.slots['app.imports'] %>

import { ApiSuccess } from './lib/api-response.js'
import type { Logger } from './lib/logger.js'
import type { ReadinessCheck } from './lib/readiness.js'
import { errorHandler } from './middlewares/error-handler.js'
import { notFound } from './middlewares/not-found.js'
import { requestId } from './middlewares/request-id.js'
import { createHealthRouter } from './routes/health.js'

export interface AppDeps {
  logger: Logger
  readinessChecks: readonly ReadinessCheck[]
}

/** Builds the app without listening, so tests use it directly (B17.2). */
export function createApp(deps: AppDeps): Express {
  const app = express()

  // Do not advertise the framework, even when no security middleware is selected.
  app.disable('x-powered-by')

  // Order (B17.2): request id, logging, security, body parsing, routes, not found, errors.
  app.use(requestId(deps.logger))
  <%~ it.slots['app.middleware'] %>
  app.use(express.json())

  app.use(createHealthRouter(deps.readinessChecks))

  // application routes (slot `app.routes`)<% if (versioned) { %>, under /v1 (D-64)<% } %>
  const api = express.Router()
  api.get('/', (_request, response) => {
    response.json(new ApiSuccess({ name: '<%= it.projectName %>'<% if (versioned) { %>, version: 'v1'<% } %> }))
  })
  <%~ it.slots['app.routes'] %>
  app.use('<%= versioned ? '/v1' : '/' %>', api)

  app.use(notFound)
  app.use(errorHandler(deps.logger))
  return app
}
