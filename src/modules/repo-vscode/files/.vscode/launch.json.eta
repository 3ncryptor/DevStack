<% const monorepo = it.modules.includes('layout-monorepo') %>
<% const apiDir = monorepo ? `\${workspaceFolder}/${it.apps.backend.dir}` : '${workspaceFolder}' %>
<% const configurations = [
  {
    // the debugger attaches to the API started by its own dev script (breakpoints in src/)
    name: 'Debug the API',
    type: 'node',
    request: 'launch',
    runtimeExecutable: it.packageManager,
    runtimeArgs: ['run', 'dev'],
    cwd: apiDir,
    console: 'integratedTerminal',
    skipFiles: ['<node_internals>/**']
  },
  ...(it.modules.includes('framework-nextjs')
    ? [{
        name: 'Debug the web app (server)',
        type: 'node',
        request: 'launch',
        runtimeExecutable: it.packageManager,
        runtimeArgs: ['run', 'dev'],
        cwd: `\${workspaceFolder}/${it.apps.frontend.dir}`,
        console: 'integratedTerminal',
        skipFiles: ['<node_internals>/**']
      }]
    : []),
  // a single-page app runs in the browser: start its dev script, then debug it in Chrome
  ...(it.modules.includes('framework-react-vite')
    ? [{
        name: 'Debug the web app (browser)',
        type: 'chrome',
        request: 'launch',
        url: `http://localhost:${it.apps.frontend.port}`,
        webRoot: `\${workspaceFolder}/${it.apps.frontend.dir}`
      }]
    : [])
] %>
<%~ JSON.stringify({ version: '0.2.0', configurations }, null, 2) %>
