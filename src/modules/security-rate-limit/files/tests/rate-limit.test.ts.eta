<% const { algorithm } = it.options %>
import assert from 'node:assert/strict'
import { test } from 'node:test'

import { createLimiter } from '../src/middlewares/rate-limit.js'

const LIMIT = 3
const WINDOW_MS = 1000
const START = 1_000_000

await test('<%= algorithm %>: allows the limit, then refuses with a retry time', () => {
  const limiter = createLimiter(LIMIT, WINDOW_MS)

  const decisions = Array.from({ length: LIMIT + 1 }, () => limiter.consume('client', START))

  assert.deepEqual(
    decisions.map((decision) => decision.allowed),
    [true, true, true, false]
  )
  assert.ok((decisions.at(-1)?.retryAfterMs ?? 0) > 0)
})

await test('<%= algorithm %>: counts each client separately', () => {
  const limiter = createLimiter(1, WINDOW_MS)

  assert.equal(limiter.consume('a', START).allowed, true)
  assert.equal(limiter.consume('b', START).allowed, true)
  assert.equal(limiter.consume('a', START).allowed, false)
})

await test('<%= algorithm %>: allows requests again once the client has waited', () => {
  const limiter = createLimiter(LIMIT, WINDOW_MS)
  for (let index = 0; index < LIMIT; index += 1) limiter.consume('client', START)
  const refused = limiter.consume('client', START)

  assert.equal(refused.allowed, false)
  assert.equal(limiter.consume('client', START + refused.retryAfterMs).allowed, true)
})
