<% const { algorithm, limit, windowMs } = it.options %>
import type { NextFunction, Request, RequestHandler, Response } from 'express'

import { toErrorResponse, TooManyRequestsError } from '../lib/errors.js'
import { createLimiter, type Limiter } from '../lib/rate-limiter.js'

export { createLimiter, type Decision, type Limiter } from '../lib/rate-limiter.js'

const LIMIT = <%= limit %>
const WINDOW_MS = <%= windowMs %>
const PRUNE_INTERVAL_MS = 60_000

// In memory, per process: behind several instances, use a shared store (Redis) instead.
const limiter = createLimiter(LIMIT, WINDOW_MS)
setInterval(() => {
  limiter.prune()
}, PRUNE_INTERVAL_MS).unref()

/**
 * Limits each client by IP with `limiter`. Behind a proxy, set `app.set('trust proxy', 1)` so
 * request.ip is the client and not the proxy. Over the limit: 429 with the error envelope,
 * `RateLimit-*` and `Retry-After` headers.
 */
export function rateLimit(limiter: Limiter): RequestHandler {
  return (request: Request, response: Response, next: NextFunction): void => {
    const decision = limiter.consume(request.ip ?? 'unknown')
    response.setHeader('RateLimit-Limit', decision.limit)
    response.setHeader('RateLimit-Remaining', decision.remaining)
    response.setHeader('RateLimit-Reset', Math.ceil(decision.resetMs / 1000))
    if (decision.allowed) {
      next()
      return
    }
    response.setHeader('Retry-After', Math.ceil(decision.retryAfterMs / 1000))
    const { status, body } = toErrorResponse(new TooManyRequestsError(), request.id)
    response.status(status).json(body)
  }
}

/** Every request (<%= algorithm %>, <%= limit %> per <%= windowMs %> ms). */
export const apiRateLimiter = rateLimit(limiter)
