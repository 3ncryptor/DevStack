[
  {
    "id": "backend-preset",
    "preset": "backend"
  },
  {
    "id": "backend-bare",
    "preset": "backend",
    "depth": "bare",
    "boot": false
  },
  {
    "id": "nest-prisma",
    "modules": [
      "framework-nest",
      "security-helmet",
      "middleware-cors",
      "security-rate-limit",
      "orm-prisma",
      "quality-eslint",
      "quality-prettier",
      "quality-husky",
      "devops-docker",
      "testing-vitest"
    ]
  },
  {
    "id": "express-docker",
    "modules": [
      "framework-express",
      "middleware-async-handler",
      "security-helmet",
      "devops-docker",
      "quality-eslint",
      "quality-prettier"
    ]
  },
  {
    "id": "monorepo-api",
    "modules": [
      "layout-monorepo",
      "framework-express",
      "orm-prisma",
      "security-helmet",
      "quality-eslint",
      "quality-prettier",
      "quality-husky"
    ]
  },
  {
    "id": "fullstack",
    "modules": [
      "layout-monorepo",
      "framework-express",
      "orm-prisma",
      "security-helmet",
      "middleware-cors",
      "framework-nextjs",
      "ui-tailwind",
      "quality-eslint",
      "quality-prettier",
      "quality-husky"
    ]
  },
  {
    "id": "owner-scenario",
    "modules": [
      "layout-monorepo",
      "framework-express",
      "arch-feature",
      "orm-prisma",
      "security-helmet",
      "middleware-cors",
      {
        "id": "security-rate-limit",
        "options": {
          "algorithm": "leaky-bucket"
        }
      },
      "middleware-request-logger",
      "api-versioning",
      "framework-nextjs",
      "ui-tailwind",
      "arch-web-feature",
      "app-admin",
      "quality-eslint",
      "quality-prettier",
      "quality-husky",
      "testing-vitest",
      "testing-vitest-web"
    ]
  },
  {
    "id": "fullstack-plain-css",
    "modules": [
      "layout-monorepo",
      "framework-nest",
      "security-helmet",
      "framework-nextjs",
      "quality-eslint",
      "quality-prettier"
    ]
  },
  {
    "id": "node-prisma",
    "modules": ["language-node", "orm-prisma", "quality-eslint", "quality-prettier"],
    "boot": false
  },
  {
    "id": "node-only",
    "modules": ["language-node", "quality-eslint", "quality-prettier"],
    "boot": false
  }
]
